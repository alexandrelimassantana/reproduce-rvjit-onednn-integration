# Convolution over oneDNN's CI shapes, forward, on each implementation the PR
# changes.

# brgemm convolution (brgemm:rvv): nhwc, f32 dst, ow >= 20, IC >= 16, sum
# post-op only. Plain user weights against the weights left to the primitive
# (blocked by the kernel's M tile) on ResNet-50, batch 1; CI test_conv_ci's
# basic and MobileNet shapes, batch 2, with the sum post-op. ResNet-50 is
# split: shapes written with groups (g1) have 5D weights, so their plain tag
# is hwigo, and benchdnn aborts on a tag of the wrong rank.
--reset
--dt=f32,bf16:bf16:f32,f16:f16:f32
--dir=FWD_B --alg=direct
--stag=axb --dtag=axb
--mb=1
--wtag=any,hwio
--batch=include/shapes_resnet_50_nog
--wtag=any,hwigo
--batch=include/shapes_resnet_50_g
--mb=2
--wtag=any
--attr-post-ops=,sum:0.5
--batch=shapes_basic
--batch=shapes_mobilenet

# gemm convolution (gemm:rvv, f32, on the rvjit sgemm): ncsp data, which the
# nhwc-only brgemm and 1x1 convolutions decline; test_conv_ci's "f32 abx
# format" section with the post-ops it takes
--reset
--dt=f32
--dir=FWD_B --alg=direct
--mb=2
--stag=abx --dtag=abx --wtag=any
--attr-post-ops=,sum:0.5,relu
--batch=shapes_basic

# 1x1 convolution (jit_1x1:rvv): nhwc, stride 1, no padding, no attributes.
# First in the list for f32; for bf16 and f16 it takes what the brgemm one
# declines, such as an f16 dst. Strided shapes fall back.
--reset
--dt=f32,f16:f16:f16
--dir=FWD_B --alg=direct
--mb=1,2
--stag=axb --dtag=axb --wtag=any
--batch=shapes_1x1
--batch=shapes_regression_1x1
--batch=shapes_3d_1x1_unit-stride_no-padding
