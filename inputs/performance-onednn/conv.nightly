# Copied from oneDNN .github/automation/performance/inputs/conv_nightly at the PR's head
# (07f60d9f29db). Changes: the --attr-fpmath=bf16 variants are removed (no
# bf16/f16 down-conversion of f32 problems in this evaluation), and --batch=conv names include/conv.pr.
--reset
--batch=include/conv.pr

--reset
--dt=f32
--alg=direct
--dir=FWD_D,FWD_B
--batch=shapes_resnet_50
