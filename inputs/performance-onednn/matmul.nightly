#
# Copied from oneDNN .github/automation/performance/inputs/matmul_nightly at the PR's head
# (07f60d9f29db). Changes: the --attr-fpmath=bf16 variants are removed (no
# bf16/f16 down-conversion of f32 problems in this evaluation), and --batch=matmul names include/matmul.pr.
--reset
--batch=include/matmul.pr
# Plain cases
--reset
--dt=f32,s8:s8:f32
--bia-dt=f32,undef
--bia_mask=2
--batch=shapes_converted_ip_inf_lb_resnet
--bia_mask=4
--batch=shapes_bert

#f16
--reset
--dt=f16:f16:f16
--bia-dt=undef
--bia_mask=2
--batch=shapes_converted_ip_inf_lb_resnet
--bia_mask=4
--batch=shapes_bert
