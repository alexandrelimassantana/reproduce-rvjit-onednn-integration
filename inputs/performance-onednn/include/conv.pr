# Copied from oneDNN .github/automation/performance/inputs/conv at the PR's head
# (07f60d9f29db). Changes: the --attr-fpmath=bf16 variants are removed (no
# bf16/f16 down-conversion of f32 problems in this evaluation).

--reset
--dir=FWD_D
--dt=f32
--alg=direct
mb1_ic64oc256_ih200oh200kh1sh1dh0ph0_iw267ow267kw1sw1dw0pw0

--reset
--dir=FWD_D
--dt=f32
--alg=auto
mb50ic64ih56oc64oh56kh3ph1n"resnet_50:res2a_branch2b*3"

